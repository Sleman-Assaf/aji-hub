# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/

# ── The virtual environment ──
# Rebuilt from requirements.txt; 9,200 files that belong to this machine, not
# to the project.
.venv/

# ── Things with content in them ──
# The database and the uploaded files are the Hub's data, not its source. They
# are 4 GB, they change constantly, and a repository is the wrong place to keep
# either. THEY ARE NOT BACKED UP BY THIS REPOSITORY — see the note at the end.
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm
media/

# Rasterised PDF pages for the document viewer. A cache: deleting it costs one
# slow page load and nothing else.
.cache/

# collectstatic output. Generated from static/, which *is* tracked.
staticfiles/

# ── Local to this machine ──
# The self-signed certificate authority for runserver_ssl. Regenerated on
# demand, and a private key does not belong in version control.
certs/
.idea/
*.log

# Spreadsheets dropped in the project root for one-off imports.
AJi_Combined_Data.xlsx
aji_hr_data.xlsx

# ── Not covered by this repository ──
# db.sqlite3 and media/ are excluded above, which means committing here does
# NOT back up the news, policies, projects, photos or messages. Those need
# their own copy somewhere off this machine.

# IT portal: on-demand database backups. Real data, never committed.
backups/

# The signing key of a served instance. Generated by serve_local.py. Committing
# it would let anybody holding a copy of the source mint a session cookie.
.secret_key

# Local environments and generated output
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.celery/
staticfiles/
logs/
backups/
media/
# Secrets and private configuration
.env
.env.*
!.env.example
production.env
.secret_key
mssql.json
iis_sso.json
certs/
*.key
*.pem
*.pfx
*.p12
*.cer
*.crt
# Databases, company imports and unrelated assets
*.sqlite3
*.sqlite3-*
*.db
*.sql
*.xlsx
*.xls
*.csv
hr_data/
PicTemplate/
bolt_kling/
*.zip
*.rar
